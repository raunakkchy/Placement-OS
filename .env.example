# GEMINI_API_KEY: Primary key for Gemini AI calls.
# You can provide 1 key, or multiple keys separated by commas for load-balancing (e.g. key1,key2,key3,key4,key5)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Or provide multiple keys in a single list:
GEMINI_API_KEYS=""

# Or specify individual keys for rotation and 5x quota load balancing:
GEMINI_API_KEY_1=""
GEMINI_API_KEY_2=""
GEMINI_API_KEY_3=""
GEMINI_API_KEY_4=""
GEMINI_API_KEY_5=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGODB_URI: Optional MongoDB connection string.
# If omitted or unavailable, PlacementOS automatically uses persistent storage.
MONGODB_URI=""

# SMTP Email Configuration for Password Reset OTP
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Placement OS <noreply@placementos.com>"
